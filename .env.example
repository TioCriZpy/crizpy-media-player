# API Key configurada en el cog web_controller (!wc setkey <clave>)
VITE_API_KEY=change-this-api-key

# URL del backend FastAPI del bot (por defecto http://localhost:8710)
VITE_API_TARGET=http://localhost:8710

# Hosts permitidos para Vite dev/preview separados por coma
VITE_ALLOWED_HOSTS=localhost,127.0.0.1
